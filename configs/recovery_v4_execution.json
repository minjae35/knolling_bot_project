{
  "schema": "recovery_driver_v2",
  "execution": "review_only",
  "allow_training": false,
  "device": "cpu",
  "seed": 1203,
  "cpu_threads": 2,
  "batch_size": 8,
  "evaluate_every": 25,
  "checkpoint_every": 25,
  "layout_lr": 0.0001,
  "perception_lr": 1e-05,
  "weight_decay": 0.0001,
  "gradient_clip": 1.0,
  "stop_on_initial_pass": true,
  "pretrained": "configs/pretrained_rtdetr.json",
  "dataset": "artifacts/pilot_v1_3_en",
  "selection": "configs/s0_samples.json",
  "model": {
    "dimension": 128,
    "layers": 2,
    "bins": 18,
    "max_objects": 8,
    "threshold": 0.5,
    "num_denoising": 100,
    "architecture": "recovery_v4_goal_joint"
  },
  "stages": {
    "grounding": {
      "max_updates": 500,
      "max_seconds": 600
    },
    "oracle_layout": {
      "max_updates": 500,
      "max_seconds": 600
    },
    "perception": {
      "max_updates": 1000,
      "max_seconds": 2700
    },
    "predicted_layout": {
      "max_updates": 1000,
      "max_seconds": 1800
    },
    "joint": {
      "max_updates": 300,
      "max_seconds": 900
    }
  },
  "data_v3": {
    "path": "artifacts/recovery_v3_verification_r1/annotations.json",
    "sha256": "1ab4d846d632d4e5c61fc14c9e0f43150536e67239ee039874bc350c4806811c"
  },
  "evaluation_schema": "recovery_metrics_v4",
  "precision": {
    "grounding": "fp32",
    "oracle_layout": "fp32",
    "perception": "fp32",
    "predicted_layout": "fp32",
    "joint": "fp32",
    "micro_pose": "fp32"
  },
  "goal_lr": 0.0003,
  "goal_contract": {
    "schema": "recovery_goal_labels_v1",
    "vocabulary": {
      "axis": [
        "horizontal",
        "vertical"
      ],
      "region": [
        "full",
        "left",
        "right"
      ],
      "gap": [
        0.015,
        0.02,
        0.03
      ],
      "group": [
        "none",
        "color"
      ],
      "sort": [
        "asc",
        "desc"
      ]
    }
  },
  "micro_pose": {
    "max_updates": 200,
    "max_seconds": 120
  },
  "budget_status": "proposed_only_requires_new_review_and_explicit_training_approval"
}
